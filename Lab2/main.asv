clear all
close all

Ts = 0.1;
Trange = [ -15:Ts :15];
%sigma_2 = 0.01;

s1 = exp( -0.1* Trange .^2);
s2 = exp( -0.1* Trange .^2) .*cos(Trange);
e = sqrt(sigma_2)*randn(size(Trange));
x = s2 + e;


figure;
plot(Trange, s1, 'r', Trange, s2, 'b')
grid on
legend('s1', 's2')
xlabel('t')
ylabel('Amplitude')


figure;
plot(Trange,x)
legend('e with sigma^2=0.01')
xlabel('t')
ylabel('Amplitude')


n = -100:100;         
s1_sampled = exp(-0.1 * (n*Ts).^2);
s2_sampled = exp(-0.1 * (n*Ts).^2) .* cos(n*Ts);
E1 = sum(abs(s1_sampled).^2);
E2 = sum(abs(s2_sampled).^2);

alpha1 = 1 / sqrt(E1);
alpha2 = 1 / sqrt(E2);

fprintf('E1 = %.4f, E2 = %.4f\n', E1, E2);
fprintf('alpha1 = %.4f, alpha2 = %.4f\n', alpha1, alpha2);


%Q6, CRB and SNR
sigma2_vals = 0.0001:0.001:1;
CRB_s1_values = zeros(size(sigma2_vals));
CRB_s2_values = zeros(size(sigma2_vals));
s1_prime = gradient(s1_sampled, Ts);
s2_prime = gradient(s2_sampled, Ts);
int_s1p2 = sum(s1_prime.^2) * Ts;
int_s2p2 = sum(s2_prime.^2) * Ts;

for i = length(sigma2_vals);
    sigma2 = sigma2_vals(i);
    CRB_s1_values(i) = sigma2/int_s1p1;
    CRB_s2_values(i) = sigma2/int_s2p2;    
end
SNR_linear = 1./sigma2_vals;
SNR_dB = 10*log10(SNR_linear);

figure;
plot(SNR_dB,sqrt(CRB_s1_values), 'r', SNR_dB, sqrt(CRB_s2_values), 'BusyAction')
legend('')
xlabel('t')
ylabel('Amplitude')




%ML estimation of T
%{
ML_estimation_vector = [];
for  T = -5:Ts:5
    sweep_signal = (exp( -0.1* (Trange-T) .^2) .*cos(Trange-T)).*x;
    ML_estimation_vector(T) = sum(sweep_signal);
end
[~, idx] = max(ML_estimation_vector);
T_hat = T(idx)
%}



